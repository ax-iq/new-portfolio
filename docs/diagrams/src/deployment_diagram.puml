Rel(external_system, firewall, "Calls", "HTTPS")
Rel(firewall, reverse_proxy, "Sends to", "")
Rel(reverse_proxy, web_app, "Calls", "HTTP")
Rel(web_app, strapi_server, "Calls api", "HTTP")
Rel(reverse_proxy, strapi_server, "Calls", "HTTP")

' Rel(web_app, db, "Reads from and writes to", "JDBC")

@enduml