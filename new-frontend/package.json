{
	"name": "new-frontend",
	"type": "module",
	"version": "0.0.1",
	"packageManager": "pnpm@10.26.2",
	"scripts": {
		"dev": "ASTRO_TELEMETRY_DISABLED=1 && astro dev",
		"build": "export ASTRO_TELEMETRY_DISABLED=1 && astro build",
		"preview": "astro preview --verbose",
		"astro": "astro",
		"start": "node --import ./instrumentation.mjs server.mjs",
		"lint:lang": "biome lint ./src",
		"format": "biome format --write ./src",
		"check": "biome check --write ./src",
		"test": "vitest",
		"test:ci": "vitest --run",
		"test:unit": "vitest --project unit --run",
		"test:browser": "vitest --project browser --run",
		"coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@astrojs/sitemap": "^3.6.1",
		"@fastify/middie": "^9.0.3",
		"@fastify/static": "^9.0.0",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/auto-instrumentations-node": "^0.67.3",
		"@opentelemetry/exporter-metrics-otlp-proto": "^0.208.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.208.0",
		"@opentelemetry/resources": "^2.2.0",
		"@opentelemetry/sdk-metrics": "^2.2.0",
		"@opentelemetry/sdk-node": "^0.208.0",
		"@opentelemetry/sdk-trace-node": "^2.2.0",
		"@opentelemetry/semantic-conventions": "^1.38.0",
		"fastify": "^5.6.2"
	},
	"devDependencies": {
		"@astrojs/node": "^9.5.1",
		"@astrojs/react": "^4.4.2",
		"@biomejs/biome": "2.3.11",
		"@heroicons/react": "^2.2.0",
		"@strapi/client": "^1.6.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.14",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@types/react": "^19.2.1",
		"@types/react-dom": "^19.2.0",
		"@vitest/browser-playwright": "4.0.14",
		"@vitest/coverage-v8": "^4.0.14",
		"astro": "^5.16.2",
		"clsx": "^2.1.1",
		"jsdom": "^27.2.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-markdown": "^10.1.0",
		"rehype-highlight": "^7.0.2",
		"remark-gfm": "^4.0.1",
		"tailwindcss": "^4.1.14",
		"vite": "^7.3.1",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.0.14",
		"vitest-browser-react": "^2.0.2"
	},
	"engines": {
		"node": ">=20.18.2 <23.0.0",
		"pnpm": ">=10.3.0 <11.0.0"
	}
}
